# ===========================================================================
#  Telegram-Bot-for-X  -  Environment configuration
# ---------------------------------------------------------------------------
#  Copy this file to ".env" and fill in the values.
#
#  NOTE: This bot is MULTI-USER. Per-user credentials (Twitter cookies and
#        xAI Grok keys) are NEVER stored here. They are collected through the
#        in-chat onboarding wizard and saved per-user inside SQLite.
#        Only infrastructure / operator settings live in this file.
# ===========================================================================

# --- Telegram -----------------------------------------------------------------
# Bot token obtained from @BotFather.  REQUIRED.
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# --- Web server (Render / Koyeb / Railway health checks) -----------------------
# Port the lightweight health-check web server listens on.
# Render injects this automatically as "10000"; locally 8000 is a good default.
PORT=8000

# --- Public URL (1-click bookmarklet onboarding) -------------------------------
# Public origin of this deployment, e.g. https://my-bot.onrender.com
# The bookmarklet installer page (/bookmarklet), the mobile webview login
# (/webview) and their credential handovers are built from this URL, so it
# MUST be an https:// address reachable from x.com. On Render you can leave
# it empty - RENDER_EXTERNAL_URL is picked up automatically. Without it the
# bot falls back to the manual paste-the-cookies wizard.
PUBLIC_BASE_URL=

# --- Database -----------------------------------------------------------------
# Path to the SQLite database file. The parent directory is created on startup.
# On Docker the ./data folder is mounted as a persistent volume.
DATABASE_PATH=data/bot.db

# --- Scheduler ----------------------------------------------------------------
# How often (in seconds) the background scheduler polls every active user's
# home timeline.  Lower = fresher feed but more requests / rate-limit risk.
POLL_INTERVAL_SECONDS=180

# Maximum number of tweets to look at per poll, per user.
MAX_TWEETS_PER_POLL=20

# --- "For you" feed quality filter --------------------------------------------
# The bot forwards two feeds: the chronological Following timeline (every new
# tweet) and a filtered algorithmic "For you" feed. A tweet must reach these
# MINIMUMS to be delivered through the For-you feed (0 = no minimum on that
# dimension). Tweets below the thresholds still arrive via the Following feed.
# Per-user overrides can be toggled with /feeds in the chat.
FOR_YOU_MIN_LIKES=0
FOR_YOU_MIN_RETWEETS=0
FOR_YOU_MIN_IMPRESSIONS=0

# --- AI translation (OpenAI-compatible provider) ------------------------------
# Any OpenAI-compatible Chat Completions endpoint works here (xAI, OpenAI,
# DeepSeek, a local Ollama/vLLM server, ...). The legacy XAI_MODEL name is
# still accepted as an alias for AI_MODEL.
#
# Base URL of the provider's API (the /chat/completions suffix is added by
# the client).
AI_BASE_URL=https://api.x.ai/v1

# Model used for tweet translations.
AI_MODEL=grok-3

# Server-wide fallback API key. Users can still register their OWN key with
# /set_grok (a per-user key always wins); when they have none, this key is
# used. Leave empty to require a per-user key.
AI_API_KEY=

# --- Logging ------------------------------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
