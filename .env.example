# ===========================================================================
#  Telegram-Bot-for-X  -  Environment configuration
# ---------------------------------------------------------------------------
#  Copy this file to ".env" and fill in the values.
#
#  NOTE: This bot is MULTI-USER. Per-user credentials (Twitter cookies and
#        xAI Grok keys) are NEVER stored here. They are collected through the
#        in-chat onboarding wizard and saved per-user inside SQLite.
#        Only infrastructure / operator settings live in this file.
# ===========================================================================

# --- Telegram -----------------------------------------------------------------
# Bot token obtained from @BotFather.  REQUIRED.
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# --- Web server (Render / Koyeb / Railway health checks) -----------------------
# Port the lightweight health-check web server listens on.
# Render injects this automatically as "10000"; locally 8000 is a good default.
PORT=8000

# --- Database -----------------------------------------------------------------
# Path to the SQLite database file. The parent directory is created on startup.
# On Docker the ./data folder is mounted as a persistent volume.
DATABASE_PATH=data/bot.db

# --- Scheduler ----------------------------------------------------------------
# How often (in seconds) the background scheduler polls every active user's
# home timeline.  Lower = fresher feed but more requests / rate-limit risk.
POLL_INTERVAL_SECONDS=180

# Maximum number of tweets to look at per poll, per user.
MAX_TWEETS_PER_POLL=20

# --- Grok (xAI) ---------------------------------------------------------------
# Default model used when a user has registered their personal xAI API key.
# Users still supply their OWN key through the bot; this only selects the model.
XAI_MODEL=grok-3

# --- Logging ------------------------------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
